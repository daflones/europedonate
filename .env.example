# ONLY on the server / Supabase Edge Function Secrets. Never put these in dist/.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive
SITE_URL=https://YOUR-DOMAIN.com
ALLOWED_ORIGINS=https://YOUR-DOMAIN.com,https://www.YOUR-DOMAIN.com
# Private random string used to hash IP addresses for checkout rate limiting.
RATE_LIMIT_SALT=
# Injected automatically in hosted Supabase Edge Functions:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Stripe Billing Portal configuration ID (bpc_...).
STRIPE_PORTAL_CONFIGURATION=

# For local preview only:
PORT=3000

# First-admin setup only. Configured on the current project; never place in frontend.
ADMIN_BOOTSTRAP_SECRET=
